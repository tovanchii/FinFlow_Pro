            <div>
              <span class="theme-text-sub block text-[11px]">Tổng Chi</span>
              <span id="filteredExpenseSum" class="num-display font-bold text-sm text-amber-400">-0 ₫</span>
            </div>
            <div>
              <span class="theme-text-sub block text-[11px]">Dòng Tiền Ròng</span>
              <span id="filteredNetSum" class="num-display font-bold text-sm">0 ₫</span>
