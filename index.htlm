<!DOCTYPE html>
<html lang="vi" class="scroll-smooth" data-theme="black-signature">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FinFlow Pro — Wealth & Debt Dashboard</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="https://unpkg.com/lucide@0.469.0/dist/umd/lucide.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root, [data-theme="black-signature"] {
      --bg-primary: #070709;
      --bg-elevated: #0e0e12;
      --bg-card: linear-gradient(155deg, rgba(24, 24, 30, 0.92) 0%, rgba(12, 12, 16, 0.96) 100%);
      --bg-card-solid: #121217;
      --bg-muted: rgba(255, 255, 255, 0.035);
      --text-primary: #f8fafc;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      --border-platinum: rgba(212, 175, 106, 0.24);
      --border-subtle: rgba(255, 255, 255, 0.08);
      --gold-start: #e6c687;
      --gold-end: #c59b4d;
      --gold-text: #e2be78;
      --gold-soft: rgba(212, 175, 106, 0.12);
      --accent-tab: linear-gradient(135deg, rgba(212, 175, 106, 0.22) 0%, rgba(99, 102, 241, 0.08) 100%);
      --shadow-luxury: 0 20px 45px -15px rgba(0, 0, 0, 0.75), inset 0 1px 0 0 rgba(255, 255, 255, 0.08);
      --radius-card: 1.35rem;
    }

    [data-theme="midnight-navy"] {
      --bg-primary: #060b16;
      --bg-elevated: #0b1324;
      --bg-card: linear-gradient(155deg, rgba(17, 28, 53, 0.92) 0%, rgba(10, 17, 34, 0.96) 100%);
      --bg-card-solid: #0f1a30;
      --bg-muted: rgba(148, 163, 184, 0.06);
      --text-primary: #f8fafc;
      --text-secondary: #94a3b8;
      --text-muted: #64748b;
      --border-platinum: rgba(129, 140, 248, 0.26);
      --border-subtle: rgba(148, 163, 184, 0.12);
      --gold-start: #818cf8;
      --gold-end: #4f46e5;
      --gold-text: #a5b4fc;
      --gold-soft: rgba(99, 102, 241, 0.14);
      --accent-tab: linear-gradient(135deg, rgba(99, 102, 241, 0.28) 0%, rgba(56, 189, 248, 0.1) 100%);
      --shadow-luxury: 0 20px 45px -15px rgba(2, 6, 23, 0.8), inset 0 1px 0 0 rgba(255, 255, 255, 0.08);
    }

    [data-theme="ivory-platinum"] {
      --bg-primary: #f6f5f0;
      --bg-elevated: #ffffff;
      --bg-card: linear-gradient(155deg, #ffffff 0%, #faf9f5 100%);
      --bg-card-solid: #ffffff;
      --bg-muted: #efede6;
      --text-primary: #0f172a;
      --text-secondary: #576071;
      --text-muted: #858e9e;
      --border-platinum: rgba(180, 148, 90, 0.3);
      --border-subtle: rgba(15, 23, 42, 0.07);
      --gold-start: #1e293b;
      --gold-end: #0f172a;
      --gold-text: #9a7432;
      --gold-soft: rgba(180, 148, 90, 0.12);
      --accent-tab: linear-gradient(135deg, rgba(15, 23, 42, 0.09) 0%, rgba(180, 148, 90, 0.14) 100%);
      --shadow-luxury: 0 14px 34px -12px rgba(15, 23, 42, 0.07), inset 0 1px 0 0 rgba(255, 255, 255, 0.9);
    }

    body {
      font-family: 'Be Vietnam Pro', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-primary);
      color: var(--text-primary);
      transition: background-color 0.3s ease, color 0.3s ease;
      -webkit-font-smoothing: antialiased;
    }

    .num-display {
      font-family: 'Inter', 'Be Vietnam Pro', sans-serif;
      letter-spacing: -0.03em;
      font-variant-numeric: tabular-nums;
    }

    .luxury-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-card);
      box-shadow: var(--shadow-luxury);
      transition: transform 0.2s ease, border-color 0.25s ease;
    }

    .luxury-card-gold {
      background: var(--bg-card);
      border: 1px solid var(--border-platinum);
      border-radius: var(--radius-card);
      box-shadow: var(--shadow-luxury);
    }

    .luxury-header {
      background: rgba(10, 10, 14, 0.82);
      border-bottom: 1px solid var(--border-subtle);
    }

    [data-theme="ivory-platinum"] .luxury-header {
      background: rgba(246, 245, 240, 0.88);
    }

    .btn-signature {
      background: linear-gradient(135deg, var(--gold-start) 0%, var(--gold-end) 100%);
      color: #09090b;
      font-weight: 700;
      box-shadow: 0 6px 20px -4px rgba(212, 175, 106, 0.45);
      transition: all 0.2s ease;
    }

    [data-theme="midnight-navy"] .btn-signature,
    [data-theme="ivory-platinum"] .btn-signature {
      color: #ffffff;
    }

    .btn-signature:hover {
      filter: brightness(1.06);
      transform: translateY(-1px);
    }

    .btn-icon-luxury {
      background: var(--bg-muted);
      border: 1px solid var(--border-subtle);
      color: var(--gold-text);
      transition: all 0.2s ease;
    }

    .btn-icon-luxury:hover {
      border-color: var(--border-platinum);
      background: var(--gold-soft);
    }

    .capsule-badge {
      background: var(--gold-soft);
      border: 1px solid var(--border-platinum);
      color: var(--gold-text);
      backdrop-filter: blur(8px);
    }

    .nav-tab {
      color: var(--text-secondary);
      border: 1px solid transparent;
      transition: all 0.2s ease;
    }

    .nav-tab.tab-active {
      background: var(--accent-tab);
      border-color: var(--border-platinum);
      color: var(--text-primary);
    }

    .theme-muted-box {
      background: var(--bg-muted);
      border: 1px solid var(--border-subtle);
    }

    .theme-text-sub {
      color: var(--text-secondary);
    }

    .theme-text-muted {
      color: var(--text-muted);
    }

    input, select, textarea {
      background-color: var(--bg-card-solid);
      color: var(--text-primary);
      border: 1px solid var(--border-subtle);
    }

    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--border-platinum);
    }

    .custom-scrollbar::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, 0.25);
      border-radius: 9999px;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col pb-24 lg:pb-10">

  <!-- ==================== A. PREMIUM TOP HEADER ==================== -->
  <header class="sticky top-0 z-30 backdrop-blur-xl luxury-header px-4 lg:px-8 py-3.5">
    <div class="max-w-6xl mx-auto">
      <!-- Top Row: Compact Brand, Capsule Badge & Action Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl btn-signature flex items-center justify-center shadow-sm">
            <i data-lucide="wallet" class="w-4 h-4 stroke-[2.2]"></i>
          </div>
          <div class="flex items-center gap-2.5">
            <h1 class="font-bold text-base sm:text-lg tracking-tight">FinFlow Pro</h1>
            <span class="text-[11px] font-medium px-2.5 py-0.5 rounded-full capsule-badge">
              v2.5 Mở Rộng
            </span>
          </div>
        </div>


      </div>

      <!-- C. Sleek Capsule Navigation Tabs -->
      <div class="mt-3.5 flex items-center gap-2 overflow-x-auto custom-scrollbar pb-0.5">
        <button data-tab="dashboard" class="nav-tab tab-active px-4 py-1.5 rounded-full text-xs font-medium flex items-center gap-2 whitespace-nowrap">
          <i data-lucide="layout-grid" class="w-3.5 h-3.5 stroke-[1.8]"></i>
          <span>Tổng quan</span>
        </button>
        <button data-tab="cashflow" class="nav-tab px-4 py-1.5 rounded-full text-xs font-medium flex items-center gap-2 whitespace-nowrap">
          <i data-lucide="arrow-left-right" class="w-3.5 h-3.5 stroke-[1.8]"></i>
          <span>Sổ Thu Chi Hằng Ngày</span>
        </button>
        <button data-tab="debts" class="nav-tab px-4 py-1.5 rounded-full text-xs font-medium flex items-center gap-2 whitespace-nowrap">
          <i data-lucide="scale" class="w-3.5 h-3.5 stroke-[1.8]"></i>
          <span>Thống Kê Nợ & Cho Vay</span>
          <span id="navDebtBadge" class="px-1.5 py-0.2 text-[10px] rounded-full bg-rose-500/20 text-rose-400 font-semibold">0</span>
        </button>
      </div>
    </div>
  </header>

  <!-- ==================== MAIN WORKSPACE ==================== -->
  <main class="flex-1 max-w-6xl w-full mx-auto px-4 lg:px-8 py-6 space-y-6">

    <!-- ==================== TAB 1: WEALTH OVERVIEW (TỔNG QUAN) ==================== -->
    <section id="tab-dashboard" class="tab-panel space-y-5">

      <!-- B. LUXURY METRIC CARDS (03. BLACK SIGNATURE LAYOUT) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">

        <!-- HERO CARD: SỐ DƯ THUẦN (THÁNG NÀY) -->
        <div class="luxury-card-gold lg:col-span-5 p-6 relative overflow-hidden flex flex-col justify-between min-h-[195px]">
          <!-- Decorative Golden Silk Waves & Signature Black Card Artwork -->
          <svg class="absolute inset-x-0 bottom-0 w-full h-28 pointer-events-none opacity-85" viewBox="0 0 400 110" preserveAspectRatio="none">
            <defs>
              <linearGradient id="goldWaveGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#c59b4d" stop-opacity="0.05" />
                <stop offset="50%" stop-color="#e6c687" stop-opacity="0.35" />
                <stop offset="100%" stop-color="#c59b4d" stop-opacity="0.1" />
              </linearGradient>
              <linearGradient id="goldFillGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#d4af37" stop-opacity="0.16" />
                <stop offset="100%" stop-color="#070709" stop-opacity="0.0" />
              </linearGradient>
            </defs>
            <path d="M0,75 C90,95 160,25 250,55 C320,78 360,35 400,45 L400,110 L0,110 Z" fill="url(#goldFillGrad)" />
            <path d="M0,75 C90,95 160,25 250,55 C320,78 360,35 400,45" fill="none" stroke="url(#goldWaveGrad)" stroke-width="2" />
            <path d="M0,92 C120,60 200,98 310,64 C355,50 380,62 400,58" fill="none" stroke="url(#goldWaveGrad)" stroke-width="1.2" stroke-dasharray="3 2" />
          </svg>

          <!-- Subtle 3D Tilted Luxury Card Emblem -->
          <div class="absolute -right-3 -bottom-4 w-28 h-20 rounded-xl border border-amber-300/30 bg-gradient-to-br from-zinc-900 via-zinc-950 to-black shadow-2xl transform -rotate-12 pointer-events-none hidden sm:flex flex-col justify-between p-2.5 opacity-90">
            <div class="flex justify-between items-center">
              <span class="w-4 h-3 rounded-sm bg-gradient-to-tr from-amber-500/80 to-yellow-200/80"></span>
              <span class="text-[7px] tracking-widest text-amber-300/70 font-semibold">SIGNATURE</span>
            </div>
            <div class="text-[8px] text-amber-200/60 tracking-widest font-mono">•••• 8899</div>
          </div>

          <!-- Top Header -->
          <div class="relative z-10 flex items-start justify-between">
            <div>
              <span class="text-[11px] font-semibold uppercase tracking-[0.08em] theme-text-sub">SỐ DƯ THUẦN (THÁNG NÀY)</span>
              <p id="kpiNetBalance" class="num-display text-3xl sm:text-4xl font-extrabold mt-2 tracking-tight">0 ₫</p>
            </div>
            <div class="w-10 h-10 rounded-xl flex items-center justify-center border" style="background: var(--gold-soft); border-color: var(--border-platinum); color: var(--gold-text);">
              <i data-lucide="credit-card" class="w-4 h-4 stroke-[1.8]"></i>
            </div>
          </div>

          <!-- Bottom Micro-Indicator & Sparkline -->
          <div class="relative z-10 mt-6 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xs theme-text-sub">Tỷ lệ tiết kiệm:</span>
              <span id="kpiSavingsRate" class="inline-flex items-center gap-1 text-xs font-bold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 rounded-full">
                ↑ 0%
              </span>
            </div>
            <svg id="sparklineNet" class="w-20 h-6 overflow-visible" viewBox="0 0 80 24"></svg>
          </div>
        </div>

        <!-- MIDDLE PAIR: TỔNG THU NHẬP & CHI PHÍ TIÊU XÀI -->
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Card: TỔNG THU NHẬP -->
          <div class="luxury-card p-5 flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-semibold uppercase tracking-[0.08em] theme-text-sub">TỔNG THU NHẬP</span>
              <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 flex items-center justify-center">
                <i data-lucide="trending-up" class="w-4 h-4 stroke-[1.9]"></i>
              </div>
            </div>
            <div class="my-3">
              <p id="kpiTotalIncome" class="num-display text-2xl sm:text-[26px] font-extrabold text-emerald-400">0 ₫</p>
            </div>
            <div class="flex items-center justify-between pt-2 border-t border-white/5 text-xs">
              <span class="theme-text-sub">Hôm nay: <strong id="kpiTodayIncome" class="text-emerald-400 font-semibold ml-1">+0 ₫</strong></span>
              <svg id="sparklineIncome" class="w-16 h-5 overflow-visible" viewBox="0 0 64 20"></svg>
            </div>
          </div>

          <!-- Card: CHI PHÍ TIÊU XÀI -->
          <div class="luxury-card p-5 flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-semibold uppercase tracking-[0.08em] theme-text-sub">CHI PHÍ TIÊU XÀI</span>
              <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/25 text-amber-400 flex items-center justify-center">
                <i data-lucide="shopping-bag" class="w-4 h-4 stroke-[1.9]"></i>
              </div>
            </div>
            <div class="my-3">
              <p id="kpiTotalExpense" class="num-display text-2xl sm:text-[26px] font-extrabold text-amber-400">0 ₫</p>
            </div>
            <div class="flex items-center justify-between pt-2 border-t border-white/5 text-xs">
              <span class="theme-text-sub">Hôm nay: <strong id="kpiTodayExpense" class="text-amber-400 font-semibold ml-1">-0 ₫</strong></span>
              <svg id="sparklineExpense" class="w-16 h-5 overflow-visible" viewBox="0 0 64 20"></svg>
            </div>
          </div>

          <!-- Card Full-Width under Pair: TỔNG DƯ NỢ PHẢI TRẢ -->
          <div class="luxury-card sm:col-span-2 p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="space-y-1.5">
              <span class="text-[11px] font-semibold uppercase tracking-[0.08em] theme-text-sub">TỔNG DƯ NỢ PHẢI TRẢ</span>
              <p id="kpiTotalDebt" class="num-display text-2xl sm:text-3xl font-extrabold text-rose-400">0 ₫</p>
              <div class="flex items-center gap-2 text-xs theme-text-sub pt-0.5">
                <span>Cho vay cần thu hồi:</span>
                <strong id="kpiTotalLoan" class="num-display text-sky-400 font-bold">0 ₫</strong>
              </div>
            </div>
            <div class="flex sm:flex-col items-center sm:items-end justify-between gap-3">
              <div class="w-10 h-10 rounded-xl bg-rose-500/10 border border-rose-500/25 text-rose-400 flex items-center justify-center">
                <i data-lucide="flame" class="w-4 h-4 stroke-[1.9]"></i>
              </div>
              <button data-goto="debts" class="text-xs font-medium px-3 py-1.5 rounded-full capsule-badge hover:opacity-90 flex items-center gap-1">
                <span>Quản lý khoản nợ</span>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- D. DATA VISUALIZATION: DÒNG TIỀN THÁNG NÀY + PHÂN BỔ CHI TIÊU + XU HƯỚNG TUẦN -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
        <!-- Minimalist Cashflow Chart Card (Matches Mockup) -->
        <div class="luxury-card p-5 sm:p-6 lg:col-span-8 flex flex-col justify-between">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-xs font-semibold uppercase tracking-[0.08em] theme-text-sub">DÒNG TIỀN THÁNG NÀY</h3>
              <select id="chartRangeSelect" class="text-xs font-medium px-3 py-1.5 rounded-full theme-muted-box cursor-pointer">
                <option value="14">Tháng này (14 ngày)</option>
                <option value="7">7 ngày qua</option>
                <option value="30">30 ngày qua</option>
              </select>
            </div>

            <!-- Inline Legend Pills -->
            <div class="flex items-center gap-6 mt-3 text-xs">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
                <span class="theme-text-sub">Thu</span>
                <strong id="chartLegendIncome" class="num-display font-bold text-emerald-400">0 ₫</strong>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
                <span class="theme-text-sub">Chi</span>
                <strong id="chartLegendExpense" class="num-display font-bold text-amber-400">0 ₫</strong>
              </div>
            </div>
          </div>

          <div class="relative h-60 mt-4">
            <canvas id="dailyCashflowChart"></canvas>
          </div>
        </div>

        <!-- Right Column: Minimalist Donut Chart & Weekly Trend Card -->
        <div class="lg:col-span-4 flex flex-col gap-5">
          <!-- Donut Chart: Phân Bổ Chi Tiêu -->
          <div class="luxury-card p-5 flex-1 flex flex-col justify-between">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-xs font-semibold uppercase tracking-[0.08em] theme-text-sub">PHÂN BỔ CHI TIÊU</h3>
              <span class="text-[11px] theme-text-muted">Tỷ trọng danh mục</span>
            </div>
            <div class="grid grid-cols-12 items-center gap-3 my-auto">
              <div class="col-span-5 relative h-32">
                <canvas id="expenseCategoryChart"></canvas>
              </div>
              <div id="categoryLegendList" class="col-span-7 space-y-2 text-xs max-h-36 overflow-y-auto custom-scrollbar pr-1"></div>
            </div>
          </div>

          <!-- Weekly Trend Card -->
          <div class="luxury-card p-5">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-semibold uppercase tracking-[0.08em] theme-text-sub">NHỊP CHI TIÊU 7 NGÀY</span>
              <span id="weeklyTrendBadge" class="text-[11px] font-semibold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full">Kiểm soát tốt</span>
            </div>
            <div class="mt-2.5 flex items-baseline justify-between">
              <div>
                <p id="weeklyAvgSpend" class="num-display text-lg font-bold">0 ₫ <span class="text-xs font-normal theme-text-sub">/ ngày</span></p>
              </div>
              <span id="weeklyTxCount" class="text-xs theme-text-sub">0 giao dịch</span>
            </div>
            <div id="weeklyMiniBars" class="grid grid-cols-7 gap-1.5 items-end h-12 mt-3 pt-2"></div>
          </div>
        </div>
      </div>

      <!-- BOTTOM SNAPSHOT: KHOẢN NỢ ƯU TIÊN & GIAO DỊCH GẦN ĐÂY -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        <!-- Priority Debts -->
        <div class="luxury-card p-5 sm:p-6">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-semibold uppercase tracking-[0.08em] theme-text-sub">KHOẢN NỢ & CHO VAY ĐANG MỞ</span>
            <button data-goto="debts" class="text-xs font-medium hover:underline" style="color: var(--gold-text);">
              Xem chi tiết →
            </button>
          </div>
          <div id="dashboardDebtList" class="space-y-3"></div>
        </div>

        <!-- Recent Daily Transactions -->
        <div class="luxury-card p-5 sm:p-6">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-semibold uppercase tracking-[0.08em] theme-text-sub">GIAO DỊCH HẰNG NGÀY MỚI NHẤT</span>
            <button data-goto="cashflow" class="text-xs font-medium hover:underline" style="color: var(--gold-text);">
              Mở sổ thu chi →
            </button>
          </div>
          <div id="dashboardRecentTx" class="space-y-2.5"></div>
        </div>
      </div>

    </section>

    <!-- ==================== TAB 2: DAILY CASHFLOW (SỔ THU CHI HẰNG NGÀY) ==================== -->
    <section id="tab-cashflow" class="tab-panel hidden space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Left Form: Quick Entry -->
        <div class="luxury-card p-6 lg:col-span-4 h-fit space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-semibold uppercase tracking-[0.08em] theme-text-sub">GHI CHÉP THU / CHI HẰNG NGÀY</h3>
            <i data-lucide="sparkles" class="w-4 h-4" style="color: var(--gold-text);"></i>
          </div>

          <form id="cashflowForm" class="space-y-4">
            <!-- Type Switch -->
            <div class="grid grid-cols-2 gap-2 p-1 rounded-xl theme-muted-box">
              <button type="button" data-txtype="expense" class="tx-type-btn py-2 rounded-lg text-xs font-semibold bg-amber-500 text-slate-950 shadow-sm transition-all">
                - Chi Phí Tiêu Xài
              </button>
              <button type="button" data-txtype="income" class="tx-type-btn py-2 rounded-lg text-xs font-semibold theme-text-sub transition-all">
                + Thu Nhập Hàng Ngày
              </button>
            </div>
            <input type="hidden" id="txTypeInput" value="expense" />

            <div>
              <label class="block text-[11px] font-medium theme-text-sub mb-1.5">Số tiền (VNĐ)</label>
              <input type="number" id="txAmountInput" required min="1000" step="1000" placeholder="VD: 150000" class="num-display w-full px-3.5 py-2.5 rounded-xl text-sm font-bold" />
              <div class="flex flex-wrap gap-1.5 mt-2">
                <button type="button" data-quickamt="50000" class="quick-amt-btn text-[11px] px-2.5 py-1 rounded-lg theme-muted-box hover:opacity-80">50k</button>
                <button type="button" data-quickamt="150000" class="quick-amt-btn text-[11px] px-2.5 py-1 rounded-lg theme-muted-box hover:opacity-80">150k</button>
                <button type="button" data-quickamt="500000" class="quick-amt-btn text-[11px] px-2.5 py-1 rounded-lg theme-muted-box hover:opacity-80">500k</button>
                <button type="button" data-quickamt="1000000" class="quick-amt-btn text-[11px] px-2.5 py-1 rounded-lg theme-muted-box hover:opacity-80">1Tr</button>
                <button type="button" data-quickamt="5000000" class="quick-amt-btn text-[11px] px-2.5 py-1 rounded-lg theme-muted-box hover:opacity-80">5Tr</button>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-[11px] font-medium theme-text-sub mb-1.5">Danh mục</label>
                <select id="txCategoryInput" class="w-full px-3 py-2.5 rounded-xl text-xs font-medium"></select>
              </div>
              <div>
                <label class="block text-[11px] font-medium theme-text-sub mb-1.5">Ngày</label>
                <input type="date" id="txDateInput" required class="w-full px-3 py-2.5 rounded-xl text-xs font-medium" />
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-medium theme-text-sub mb-1.5">Nguồn tiền</label>
              <select id="txWalletInput" class="w-full px-3 py-2.5 rounded-xl text-xs font-medium">
                <option value="Tài khoản Ngân hàng">Tài khoản Ngân hàng</option>
                <option value="Tiền mặt">Tiền mặt hằng ngày</option>
                <option value="Ví điện tử">Ví điện tử (MoMo / Apple Pay)</option>
                <option value="Thẻ tín dụng">Thẻ tín dụng Signature</option>
              </select>
            </div>

            <div>
              <label class="block text-[11px] font-medium theme-text-sub mb-1.5">Nội dung giao dịch</label>
              <input type="text" id="txNoteInput" required placeholder="VD: Ăn trưa, Nhận thanh toán dự án..." class="w-full px-3.5 py-2.5 rounded-xl text-xs" />
            </div>

            <button type="submit" class="w-full btn-signature py-3 rounded-xl text-xs uppercase tracking-wider font-bold flex items-center justify-center gap-2">
              <i data-lucide="check" class="w-4 h-4 stroke-[2.4]"></i>
              <span>Lưu Giao Dịch</span>
            </button>
          </form>
        </div>

        <!-- Right List: Daily Ledger -->
        <div class="luxury-card p-6 lg:col-span-8 flex flex-col space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-[0.08em] theme-text-sub">NHẬT KÝ DÒNG TIỀN HẰNG NGÀY</h3>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <div class="relative">
                <input type="text" id="txSearchInput" placeholder="Tìm giao dịch..." class="pl-8 pr-3 py-1.5 rounded-full text-xs" />
                <i data-lucide="search" class="w-3.5 h-3.5 theme-text-sub absolute left-3 top-2"></i>
              </div>
              <select id="txFilterType" class="px-3 py-1.5 rounded-full text-xs font-medium">
                <option value="all">Tất cả</option>
                <option value="expense">Chi tiêu</option>
                <option value="income">Thu nhập</option>
              </select>
              <select id="txFilterCategory" class="px-3 py-1.5 rounded-full text-xs font-medium">
                <option value="all">Mọi danh mục</option>
              </select>
            </div>
          </div>

          <!-- Filtered Summary Strip -->
          <div class="grid grid-cols-3 gap-3 p-3.5 rounded-2xl theme-muted-box text-xs">
            <div>
              <span class="theme-text-sub block text-[11px]">Tổng Thu</span>
              <span id="filteredIncomeSum" class="num-display font-bold text-sm text-emerald-400">+0 ₫</span>
