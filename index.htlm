  <!-- ==================== LUXURY COMPLETION POPUP MODAL ==================== -->
  <div id="toastBox" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden items-center justify-center p-4">
    <div class="luxury-card-gold max-w-sm w-full p-6 space-y-5 shadow-2xl relative overflow-hidden text-center">
      <!-- Top Decorative Glow -->
      <div class="w-14 h-14 rounded-2xl mx-auto flex items-center justify-center border shadow-lg" id="popupIconWrap" style="background: var(--gold-soft); border-color: var(--border-platinum); color: var(--gold-text);">
        <i id="popupIcon" data-lucide="check-circle-2" class="w-7 h-7 stroke-[2.2]"></i>
      </div>

      <div class="space-y-1">
        <span id="popupBadge" class="inline-block text-[10px] font-bold uppercase tracking-[0.12em] px-3 py-0.5 rounded-full capsule-badge">
          HOÀN TẤT LƯU SỐ LIỆU
        </span>
        <h3 id="toastMessage" class="font-bold text-base sm:text-lg pt-1">Đã lưu hoạt động thành công!</h3>
        <p id="popupSubtitle" class="text-xs theme-text-sub">Số liệu đã được cập nhật vào bảng điều khiển của bạn</p>
      </div>

      <!-- Receipt Summary Box -->
      <div id="popupDetailsBox" class="p-4 rounded-2xl theme-muted-box text-left space-y-2.5 text-xs">
      </div>

      <!-- Popup Action Buttons -->
      <div class="grid grid-cols-2 gap-2.5 pt-1">
        <button type="button" id="btnClosePopupModal" class="py-2.5 px-4 rounded-full text-xs font-semibold theme-muted-box hover:opacity-85">
          Đóng lại
        </button>
        <button type="button" id="btnPopupGoDashboard" class="py-2.5 px-4 rounded-full text-xs font-bold btn-signature">
          Xem Tổng Quan
        </button>
      </div>
    </div>
  </div>

  <script>
    // ==================== STATE & DEFAULT DATA ====================
    const STORAGE_KEY = 'finflow_black_signature_zero_v1';

    const EXPENSE_CATEGORIES = [
      'Ăn uống & Cafe',
      'Di chuyển & Xăng xe',
      'Nhà cửa & Điện nước',
      'Mua sắm & Sinh hoạt',
      'Trả nợ & Lãi vay',
      'Giải trí & Sức khỏe'
    ];

    const INCOME_CATEGORIES = [
      'Lương chính',
      'Thưởng & Cổ tức',
      'Freelance / Kinh doanh',
      'Thu hồi nợ cho vay',
      'Thu nhập khác'
    ];

    function getOffsetDate(daysAgo) {
      const d = new Date();
      d.setDate(d.getDate() - daysAgo);
      return d.toISOString().split('T')[0];
    }

    function createInitialState() {
      return {
        theme: 'black-signature',
        transactions: [],
        debts: []
      };
    }

    let appState = loadState();
    let activeDebtFilter = 'all';
    let dailyChartInstance = null;
    let categoryChartInstance = null;

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          return Object.assign(createInitialState(), parsed);
        }
      } catch (err) {
        // Fallback in sandboxed iframe
      }
      return createInitialState();
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
      } catch (err) {
        // Ignore storage error
      }
    }

    function formatVND(num) {
      const val = Math.round(Number(num) || 0);
      return val.toLocaleString('vi-VN') + ' ₫';
    }

    function formatCompactM(num) {
      const val = Number(num) || 0;
      if (val >= 1000000) {
        return (val / 1000000).toFixed(2).replace('.', ',') + 'M';
      }
      if (val >= 1000) {
        return Math.round(val / 1000) + 'k';
      }
      return val.toString();
    }

    function showToast(msg, details = null) {
      const box = document.getElementById('toastBox');
      const text = document.getElementById('toastMessage');
      const badge = document.getElementById('popupBadge');
      const subtitle = document.getElementById('popupSubtitle');
      const detailsBox = document.getElementById('popupDetailsBox');
      const iconWrap = document.getElementById('popupIconWrap');

      text.textContent = msg;

      if (details) {
        badge.textContent = details.badge || 'HOÀN TẤT LƯU SỐ LIỆU';
        subtitle.textContent = details.subtitle || 'Dữ liệu đã được đồng bộ vào hệ thống';
        if (details.tone === 'income') {
          iconWrap.style.background = 'rgba(16, 185, 129, 0.14)';
          iconWrap.style.borderColor = 'rgba(52, 211, 153, 0.35)';
          iconWrap.style.color = '#34d399';
        } else if (details.tone === 'expense') {
          iconWrap.style.background = 'rgba(245, 158, 11, 0.14)';
          iconWrap.style.borderColor = 'rgba(251, 191, 36, 0.35)';
          iconWrap.style.color = '#fbbf24';
        } else if (details.tone === 'debt') {
          iconWrap.style.background = 'rgba(244, 63, 94, 0.14)';
          iconWrap.style.borderColor = 'rgba(251, 113, 133, 0.35)';
          iconWrap.style.color = '#fb7185';
        } else {
          iconWrap.style.background = 'var(--gold-soft)';
          iconWrap.style.borderColor = 'var(--border-platinum)';
          iconWrap.style.color = 'var(--gold-text)';
        }

        if (details.rows && details.rows.length > 0) {
          detailsBox.classList.remove('hidden');
          detailsBox.innerHTML = details.rows.map(r => `
            <div class="flex items-center justify-between gap-2">
              <span class="theme-text-sub">${r.label}</span>
              <strong class="num-display font-bold ${r.color || ''}">${r.value}</strong>
            </div>
          `).join('');
        } else {
          detailsBox.classList.add('hidden');
        }
      } else {
        badge.textContent = 'THÔNG BÁO HỆ THỐNG';
        subtitle.textContent = 'Trạng thái đã được cập nhật thành công';
        iconWrap.style.background = 'var(--gold-soft)';
        iconWrap.style.borderColor = 'var(--border-platinum)';
        iconWrap.style.color = 'var(--gold-text)';
        detailsBox.classList.add('hidden');
      }

      box.classList.remove('hidden');
      box.classList.add('flex');
      if (window.lucide) window.lucide.createIcons();
    }

    function applyTheme() {
      document.documentElement.setAttribute('data-theme', appState.theme || 'black-signature');
    }

    // ==================== MINI SPARKLINE GENERATOR ====================
    function drawSparkline(svgId, values, strokeColor) {
      const svg = document.getElementById(svgId);
      if (!svg || !values.length) return;
      const w = 64;
      const h = 20;
      const min = Math.min(...values);
      const max = Math.max(...values, min + 1);
      const pts = values.map((v, idx) => {
        const x = (idx / Math.max(1, values.length - 1)) * w;
        const y = h - ((v - min) / (max - min)) * (h - 4) - 2;
        return `${x.toFixed(1)},${y.toFixed(1)}`;
      }).join(' ');
      svg.innerHTML = `
        <polyline fill="none" stroke="${strokeColor}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" points="${pts}" />
      `;
    }

    // ==================== RENDER ALL ====================
    function renderAll() {
      applyTheme();
      renderDashboard();
      renderCashflowTab();
      renderDebtsTab();
      if (window.lucide) {
        window.lucide.createIcons();
      }
    }

    function renderDashboard() {
      const todayStr = getOffsetDate(0);

      let totalIncome = 0;
      let totalExpense = 0;
      let todayIncome = 0;
      let todayExpense = 0;

      appState.transactions.forEach(t => {
        if (t.type === 'income') {
          totalIncome += Number(t.amount);
          if (t.date === todayStr) todayIncome += Number(t.amount);
        } else {
          totalExpense += Number(t.amount);
          if (t.date === todayStr) todayExpense += Number(t.amount);
        }
      });

      const netBalance = totalIncome - totalExpense;
      const savingsRate = totalIncome > 0 ? Math.max(0, Math.round((netBalance / totalIncome) * 100)) : 0;

      let totalDebtRemaining = 0;
      let totalLoanRemaining = 0;
      let activeDebtsCount = 0;

      appState.debts.forEach(d => {
        const rem = Math.max(0, Number(d.totalAmount) - Number(d.paidAmount));
        if (d.type === 'borrowed') {
          totalDebtRemaining += rem;
          if (rem > 0) activeDebtsCount++;
        } else {
          totalLoanRemaining += rem;
        }
      });

      document.getElementById('kpiNetBalance').textContent = formatVND(netBalance);
      document.getElementById('kpiSavingsRate').textContent = `↑ ${savingsRate}%`;
      document.getElementById('kpiTotalIncome').textContent = formatVND(totalIncome);
      document.getElementById('kpiTodayIncome').textContent = '+' + formatVND(todayIncome);
      document.getElementById('kpiTotalExpense').textContent = formatVND(totalExpense);
      document.getElementById('kpiTodayExpense').textContent = '-' + formatVND(todayExpense);
      document.getElementById('kpiTotalDebt').textContent = formatVND(totalDebtRemaining);
      document.getElementById('kpiTotalLoan').textContent = formatVND(totalLoanRemaining);
      document.getElementById('navDebtBadge').textContent = activeDebtsCount;

      document.getElementById('chartLegendIncome').textContent = formatCompactM(totalIncome);
      document.getElementById('chartLegendExpense').textContent = formatCompactM(totalExpense);

      // Sparklines & 7-Day Weekly Trend
      const last7Inc = [];
      const last7Exp = [];
      const last7Net = [];
      for (let i = 6; i >= 0; i--) {
        const dStr = getOffsetDate(i);
        const dayInc = appState.transactions.filter(t => t.date === dStr && t.type === 'income').reduce((s, t) => s + Number(t.amount), 0);
        const dayExp = appState.transactions.filter(t => t.date === dStr && t.type === 'expense').reduce((s, t) => s + Number(t.amount), 0);
        last7Inc.push(dayInc);
        last7Exp.push(dayExp);
        last7Net.push(dayInc - dayExp);
      }
      drawSparkline('sparklineNet', last7Net, '#34d399');
      drawSparkline('sparklineIncome', last7Inc, '#2dd4bf');
      drawSparkline('sparklineExpense', last7Exp, '#fbbf24');

      // Weekly Trend Card
      const sum7Exp = last7Exp.reduce((a, b) => a + b, 0);
      const avg7Exp = Math.round(sum7Exp / 7);
      document.getElementById('weeklyAvgSpend').innerHTML = `${formatVND(avg7Exp)} <span class="text-xs font-normal theme-text-sub">/ ngày</span>`;
      document.getElementById('weeklyTxCount').textContent = `${appState.transactions.length} giao dịch`;

      const max7 = Math.max(...last7Exp, 1);
      document.getElementById('weeklyMiniBars').innerHTML = last7Exp.map((val, idx) => {
        const hPct = Math.max(15, Math.round((val / max7) * 100));
        const isToday = idx === 6;
        return `
          <div class="flex flex-col items-center gap-1 h-full justify-end">
            <div class="w-full rounded-t-md ${isToday ? 'bg-amber-400' : 'bg-white/15'}" style="height:${hPct}%"></div>
            <span class="text-[9px] theme-text-muted">T${idx + 2 > 7 ? 'CN' : idx + 2}</span>
          </div>
        `;
      }).join('');

      // Priority Debts Snapshot
      const debtContainer = document.getElementById('dashboardDebtList');
      const activeDebts = appState.debts.filter(d => (d.totalAmount - d.paidAmount) > 0).slice(0, 3);
      if (activeDebts.length === 0) {
        debtContainer.innerHTML = `<p class="text-xs theme-text-sub py-4 text-center">Không có khoản nợ nào đang tồn đọng.</p>`;
      } else {
        debtContainer.innerHTML = activeDebts.map(d => {
          const rem = d.totalAmount - d.paidAmount;
          const pct = Math.min(100, Math.round((d.paidAmount / d.totalAmount) * 100));
          const isBorrowed = d.type === 'borrowed';
          return `
            <div class="p-3.5 rounded-2xl theme-muted-box flex flex-col gap-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full ${isBorrowed ? 'bg-rose-400' : 'bg-sky-400'}"></span>
                  <h4 class="font-semibold text-xs">${d.title}</h4>
                </div>
                <span class="num-display text-xs font-bold ${isBorrowed ? 'text-rose-400' : 'text-sky-400'}">${formatVND(rem)}</span>
              </div>
              <div class="w-full h-1.5 rounded-full bg-white/10 overflow-hidden">
                <div class="h-full ${isBorrowed ? 'bg-gradient-to-r from-amber-400 to-rose-400' : 'bg-sky-400'}" style="width: ${pct}%"></div>
              </div>
              <div class="flex items-center justify-between text-[11px] theme-text-sub">
                <span>Đã trả ${pct}% • Hạn: ${d.dueDate}</span>
                <button data-paydebt="${d.id}" class="font-semibold hover:underline" style="color: var(--gold-text);">
                  ${isBorrowed ? 'Trả bớt →' : 'Thu hồi →'}
                </button>
              </div>
            </div>
          `;
        }).join('');
      }

      // Recent Transactions Snapshot
      const recentTxContainer = document.getElementById('dashboardRecentTx');
      const sortedTx = [...appState.transactions].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 4);
      if (sortedTx.length === 0) {
        recentTxContainer.innerHTML = `<p class="text-xs theme-text-sub py-4 text-center">Chưa có giao dịch nào. Bấm dấu (+) ở thanh dưới để thêm hoạt động.</p>`;
      } else {
        recentTxContainer.innerHTML = sortedTx.map(t => {
        const isInc = t.type === 'income';
        return `
          <div class="flex items-center justify-between p-3 rounded-2xl theme-muted-box">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-xl flex items-center justify-center ${isInc ? 'bg-emerald-500/10 text-emerald-400' : 'bg-amber-500/10 text-amber-400'}">
                <i data-lucide="${isInc ? 'arrow-down-left' : 'arrow-up-right'}" class="w-4 h-4"></i>
              </div>
              <div>
                <p class="text-xs font-semibold">${t.note}</p>
                <p class="text-[11px] theme-text-sub">${t.category} • ${t.date}</p>
              </div>
            </div>
            <span class="num-display text-xs font-bold ${isInc ? 'text-emerald-400' : 'text-amber-400'}">
              ${isInc ? '+' : '-'}${formatVND(t.amount)}
            </span>
          </div>
        `;
      }).join('');
      }

      renderCharts();
    }

    function renderCharts() {
      const rangeDays = Number(document.getElementById('chartRangeSelect').value || 14);
      const labels = [];
      const incomeSeries = [];
      const expenseSeries = [];

      for (let i = rangeDays - 1; i >= 0; i--) {
        const dStr = getOffsetDate(i);
        labels.push('T' + (rangeDays - i));
        const dayInc = appState.transactions
          .filter(t => t.date === dStr && t.type === 'income')
          .reduce((s, t) => s + Number(t.amount), 0);
        const dayExp = appState.transactions
          .filter(t => t.date === dStr && t.type === 'expense')
          .reduce((s, t) => s + Number(t.amount), 0);
        incomeSeries.push(dayInc);
        expenseSeries.push(dayExp);
      }

      const ctxDaily = document.getElementById('dailyCashflowChart').getContext('2d');
      if (dailyChartInstance) dailyChartInstance.destroy();

      const gradExpense = ctxDaily.createLinearGradient(0, 0, 0, 220);
      gradExpense.addColorStop(0, '#f59e0b');
      gradExpense.addColorStop(1, 'rgba(217, 119, 6, 0.25)');

      const gradIncome = ctxDaily.createLinearGradient(0, 0, 0, 220);
      gradIncome.addColorStop(0, '#34d399');
      gradIncome.addColorStop(1, 'rgba(16, 185, 129, 0.2)');

      dailyChartInstance = new Chart(ctxDaily, {
        type: 'bar',
        data: {
          labels,
          datasets: [
            {
              label: 'Thu nhập',
              data: incomeSeries,
              backgroundColor: gradIncome,
              borderRadius: 99,
              barPercentage: 0.55,
              categoryPercentage: 0.7
            },
            {
              label: 'Chi tiêu',
              data: expenseSeries,
              backgroundColor: gradExpense,
              borderRadius: 99,
              barPercentage: 0.55,
              categoryPercentage: 0.7
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false }
          },
          scales: {
            y: {
              beginAtZero: true,
              grid: { color: 'rgba(148, 163, 184, 0.08)', drawBorder: false },
              ticks: {
                color: '#64748b',
                callback: val => (val >= 1000000 ? (val / 1000000).toFixed(0) + 'M' : val / 1000 + 'k'),
                font: { size: 10 }
              }
            },
            x: {
              grid: { display: false },
              ticks: { color: '#64748b', font: { size: 10 } }
            }
          }
        }
      });

      // Minimalist Donut Chart
      const catTotals = {};
      appState.transactions.filter(t => t.type === 'expense').forEach(t => {
        catTotals[t.category] = (catTotals[t.category] || 0) + Number(t.amount);
      });
      const catLabels = Object.keys(catTotals);
      const catValues = Object.values(catTotals);
      const luxuryPalette = ['#e6c687', '#f59e0b', '#fb7185', '#34d399', '#38bdf8', '#a78bfa'];

      const ctxCat = document.getElementById('expenseCategoryChart').getContext('2d');
      if (categoryChartInstance) categoryChartInstance.destroy();
      const hasCatData = catValues.length > 0;
      categoryChartInstance = new Chart(ctxCat, {
        type: 'doughnut',
        data: {
          labels: hasCatData ? catLabels : ['Chưa có chi tiêu'],
          datasets: [{
            data: hasCatData ? catValues : [1],
            backgroundColor: hasCatData ? luxuryPalette.slice(0, catLabels.length) : ['rgba(148, 163, 184, 0.12)'],
            borderWidth: 0,
            hoverOffset: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '74%',
          plugins: { legend: { display: false } }
        }
      });

      const totalExp = catValues.reduce((a, b) => a + b, 0) || 1;
      if (!hasCatData) {
        document.getElementById('categoryLegendList').innerHTML = `<p class="text-[11px] theme-text-sub">Chưa phát sinh dữ liệu chi tiêu.</p>`;
      } else {
        document.getElementById('categoryLegendList').innerHTML = catLabels.map((cat, idx) => {
        const pct = Math.round((catValues[idx] / totalExp) * 100);
        return `
          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2 truncate">
              <span class="w-2 h-2 rounded-full shrink-0" style="background:${luxuryPalette[idx % luxuryPalette.length]}"></span>
              <span class="truncate theme-text-sub text-[11px]">${cat}</span>
            </div>
            <span class="num-display font-semibold text-[11px]">${pct}%</span>
          </div>
        `;
      }).join('');
      }
    }

    // ==================== TAB 2: CASHFLOW LEDGER ====================
    function populateCategoryDropdowns() {
      const txType = document.getElementById('txTypeInput').value;
      const list = txType === 'income' ? INCOME_CATEGORIES : EXPENSE_CATEGORIES;
      const selectEl = document.getElementById('txCategoryInput');
      selectEl.innerHTML = list.map(c => `<option value="${c}">${c}</option>`).join('');

      const filterCatEl = document.getElementById('txFilterCategory');
      const currentVal = filterCatEl.value || 'all';
      const allCats = [...new Set([...EXPENSE_CATEGORIES, ...INCOME_CATEGORIES])];
      filterCatEl.innerHTML = `<option value="all">Mọi danh mục</option>` + allCats.map(c => `<option value="${c}">${c}</option>`).join('');
      filterCatEl.value = currentVal;
    }

    function renderCashflowTab() {
      populateCategoryDropdowns();
      const dateInput = document.getElementById('txDateInput');
      if (!dateInput.value) dateInput.value = getOffsetDate(0);

      const query = (document.getElementById('txSearchInput').value || '').toLowerCase().trim();
      const typeFilter = document.getElementById('txFilterType').value;
      const catFilter = document.getElementById('txFilterCategory').value;

      const filtered = appState.transactions.filter(t => {
        if (typeFilter !== 'all' && t.type !== typeFilter) return false;
        if (catFilter !== 'all' && t.category !== catFilter) return false;
        if (query && !t.note.toLowerCase().includes(query) && !t.category.toLowerCase().includes(query)) return false;
        return true;
      }).sort((a, b) => b.date.localeCompare(a.date));

      let sumInc = 0;
      let sumExp = 0;
      filtered.forEach(t => {
        if (t.type === 'income') sumInc += Number(t.amount);
        else sumExp += Number(t.amount);
      });

      document.getElementById('filteredIncomeSum').textContent = '+' + formatVND(sumInc);
      document.getElementById('filteredExpenseSum').textContent = '-' + formatVND(sumExp);
      document.getElementById('filteredNetSum').textContent = formatVND(sumInc - sumExp);

      const grouped = {};
      filtered.forEach(t => {
        if (!grouped[t.date]) grouped[t.date] = [];
        grouped[t.date].push(t);
      });

      const container = document.getElementById('dailyLedgerContainer');
      const dates = Object.keys(grouped).sort((a, b) => b.localeCompare(a));

      if (dates.length === 0) {
        container.innerHTML = `<div class="p-8 text-center theme-text-sub text-xs">Chưa có giao dịch khớp bộ lọc.</div>`;
        return;
      }

      container.innerHTML = dates.map(date => {
        const items = grouped[date];
        const dayIn = items.filter(i => i.type === 'income').reduce((s, i) => s + Number(i.amount), 0);
        const dayOut = items.filter(i => i.type === 'expense').reduce((s, i) => s + Number(i.amount), 0);

        return `
          <div class="rounded-2xl theme-muted-box overflow-hidden">
            <div class="px-4 py-2.5 border-b border-white/5 flex items-center justify-between text-xs">
              <span class="font-semibold theme-text-sub">${date}</span>
              <div class="flex items-center gap-3 num-display font-semibold">
                ${dayIn > 0 ? `<span class="text-emerald-400">+${formatVND(dayIn)}</span>` : ''}
                ${dayOut > 0 ? `<span class="text-amber-400">-${formatVND(dayOut)}</span>` : ''}
              </div>
            </div>
            <div class="divide-y divide-white/5">
              ${items.map(t => {
                const isInc = t.type === 'income';
                return `
                  <div class="px-4 py-3 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                      <span class="w-1.5 h-7 rounded-full ${isInc ? 'bg-emerald-400' : 'bg-amber-400'}"></span>
                      <div>
                        <p class="text-xs font-semibold">${t.note}</p>
                        <p class="text-[11px] theme-text-sub">${t.category} • ${t.wallet}</p>
                      </div>
                    </div>
                    <div class="flex items-center gap-3">
                      <span class="num-display text-xs font-bold ${isInc ? 'text-emerald-400' : 'text-amber-400'}">
                        ${isInc ? '+' : '-'}${formatVND(t.amount)}
                      </span>
                      <button data-deltx="${t.id}" class="theme-text-muted hover:text-rose-400 p-1" title="Xóa">
                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                      </button>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
      }).join('');
    }

    // ==================== TAB 3: DEBTS PORTFOLIO ====================
    function renderDebtsTab() {
      let sumBorrowedRem = 0;
      let sumBorrowedPaid = 0;
      let sumBorrowedTotal = 0;
      let countBorrowed = 0;
      let sumLentRem = 0;
      let countLent = 0;

      appState.debts.forEach(d => {
        const rem = Math.max(0, d.totalAmount - d.paidAmount);
        if (d.type === 'borrowed') {
          sumBorrowedRem += rem;
          sumBorrowedPaid += Number(d.paidAmount);
          sumBorrowedTotal += Number(d.totalAmount);
          if (rem > 0) countBorrowed++;
        } else {
          sumLentRem += rem;
          if (rem > 0) countLent++;
        }
      });

      const avgPct = sumBorrowedTotal > 0 ? Math.round((sumBorrowedPaid / sumBorrowedTotal) * 100) : 0;

      document.getElementById('debtSummaryBorrowed').textContent = formatVND(sumBorrowedRem);
      document.getElementById('debtCountBorrowed').textContent = countBorrowed + ' khoản nợ đang trả';
      document.getElementById('debtSummaryPaid').textContent = formatVND(sumBorrowedPaid);
      document.getElementById('debtProgressAvg').textContent = 'Tiến độ hoàn thành: ' + avgPct + '%';
      document.getElementById('debtSummaryLent').textContent = formatVND(sumLentRem);
      document.getElementById('debtCountLent').textContent = countLent + ' khoản cho vay cần thu';

      const filteredDebts = appState.debts.filter(d => {
        if (activeDebtFilter === 'all') return true;
        return d.type === activeDebtFilter;
      });

      const grid = document.getElementById('debtCardsGrid');
      if (filteredDebts.length === 0) {
        grid.innerHTML = `<div class="luxury-card p-8 md:col-span-2 lg:col-span-3 text-center text-xs theme-text-sub">Chưa có khoản nợ hoặc khoản cho vay nào. Bấm "+ Thêm Khoản Nợ / Cho Vay" để bắt đầu theo dõi.</div>`;
        return;
      }
      grid.innerHTML = filteredDebts.map(d => {
        const rem = Math.max(0, d.totalAmount - d.paidAmount);
        const pct = Math.min(100, Math.round((d.paidAmount / d.totalAmount) * 100));
        const isBorrowed = d.type === 'borrowed';
        return `
          <div class="luxury-card p-5 flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold ${isBorrowed ? 'bg-rose-500/15 text-rose-400' : 'bg-sky-500/15 text-sky-400'}">
                  ${isBorrowed ? 'NỢ PHẢI TRẢ' : 'KHOẢN CHO VAY'}
                </span>
                <div class="flex items-center gap-1.5">
                  <span class="text-[10px] px-2 py-0.5 rounded-full theme-muted-box theme-text-sub">${d.priority}</span>
                  <button data-deldebt="${d.id}" class="p-1 theme-text-muted hover:text-rose-400" title="Xóa">
                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                  </button>
                </div>
              </div>

              <h4 class="font-bold text-sm mt-3">${d.title}</h4>
              <p class="text-[11px] theme-text-sub mt-0.5">${d.note || 'Không có ghi chú'}</p>

              <div class="grid grid-cols-2 gap-2 my-3.5 p-3 rounded-2xl theme-muted-box text-xs">
                <div>
                  <span class="theme-text-sub block text-[10px]">Còn lại</span>
                  <span class="num-display font-extrabold text-sm ${isBorrowed ? 'text-rose-400' : 'text-sky-400'}">${formatVND(rem)}</span>
                </div>
                <div>
                  <span class="theme-text-sub block text-[10px]">Tổng gốc</span>
                  <span class="num-display font-semibold text-sm">${formatVND(d.totalAmount)}</span>
                </div>
              </div>

              <div class="space-y-1.5">
                <div class="flex justify-between text-[11px]">
                  <span class="theme-text-sub">Đã trả: <strong class="num-display text-white/90">${formatVND(d.paidAmount)}</strong></span>
                  <span class="num-display font-bold">${pct}%</span>
                </div>
                <div class="w-full h-1.5 rounded-full bg-white/10 overflow-hidden">
                  <div class="h-full ${isBorrowed ? 'bg-gradient-to-r from-amber-400 to-rose-400' : 'bg-sky-400'} transition-all duration-300" style="width:${pct}%"></div>
                </div>
              </div>
            </div>

            <div class="pt-3 border-t border-white/5 flex items-center justify-between text-xs">
              <span class="theme-text-sub text-[11px]">Lãi: ${d.interestRate}%/năm • Hạn: ${d.dueDate}</span>
              ${rem > 0 ? `
                <button data-paydebt="${d.id}" class="px-3.5 py-1.5 rounded-full font-semibold text-xs btn-signature">
                  ${isBorrowed ? 'Trả bớt' : 'Thu nợ'}
                </button>
              ` : `<span class="text-emerald-400 font-semibold">Đã tất toán ✓</span>`}
            </div>
          </div>
        `;
      }).join('');
    }

    // ==================== INTERACTION HANDLERS ====================
    function activateTab(tabName) {
      document.querySelectorAll('.nav-tab[data-tab]').forEach(b => {
        b.classList.toggle('tab-active', b.getAttribute('data-tab') === tabName);
      });
      document.querySelectorAll('.dock-btn').forEach(b => {
        const active = b.getAttribute('data-docktab') === tabName;
        b.style.color = active ? 'var(--gold-text)' : 'var(--text-secondary)';
      });
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
      const panel = document.getElementById('tab-' + tabName);
      if (panel) panel.classList.remove('hidden');
      renderAll();
    }

    document.addEventListener('DOMContentLoaded', () => {
      renderAll();

      // Top Tabs & Bottom Dock Navigation
      document.querySelectorAll('.nav-tab[data-tab]').forEach(btn => {
        btn.addEventListener('click', () => activateTab(btn.getAttribute('data-tab')));
      });
      document.querySelectorAll('.dock-btn').forEach(btn => {
        btn.addEventListener('click', () => activateTab(btn.getAttribute('data-docktab')));
      });

      document.querySelectorAll('[data-goto]').forEach(btn => {
        btn.addEventListener('click', () => activateTab(btn.getAttribute('data-goto')));
      });

      // Quick Transaction Entry
      const goQuickTx = () => {
        activateTab('cashflow');
        document.getElementById('txAmountInput').focus();
      };
      document.getElementById('btnDockPlus').addEventListener('click', goQuickTx);

      // Debt Modal
      const openDebtModal = () => {
        document.getElementById('debtDueInput').value = getOffsetDate(-15);
        document.getElementById('debtModal').classList.remove('hidden');
        document.getElementById('debtModal').classList.add('flex');
      };
      document.getElementById('btnOpenDebtModal2').addEventListener('click', openDebtModal);

      const closeDebtModal = () => {
        document.getElementById('debtModal').classList.add('hidden');
        document.getElementById('debtModal').classList.remove('flex');
      };
      document.getElementById('btnCloseDebtModal').addEventListener('click', closeDebtModal);
      document.getElementById('btnCancelDebtModal').addEventListener('click', closeDebtModal);

      // Cashflow Type Switch
      document.querySelectorAll('.tx-type-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const t = btn.getAttribute('data-txtype');
          document.getElementById('txTypeInput').value = t;
          document.querySelectorAll('.tx-type-btn').forEach(b => {
            b.className = 'tx-type-btn py-2 rounded-lg text-xs font-semibold theme-text-sub transition-all';
          });
          btn.className = `tx-type-btn py-2 rounded-lg text-xs font-semibold text-slate-950 shadow-sm transition-all ${t === 'income' ? 'bg-emerald-400' : 'bg-amber-400'}`;
          populateCategoryDropdowns();
        });
      });

      // Quick Amounts
      document.querySelectorAll('.quick-amt-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.getElementById('txAmountInput').value = btn.getAttribute('data-quickamt');
        });
      });

      // Submit Transaction
      document.getElementById('cashflowForm').addEventListener('submit', e => {
        e.preventDefault();
        const type = document.getElementById('txTypeInput').value;
        const amount = Number(document.getElementById('txAmountInput').value);
        const category = document.getElementById('txCategoryInput').value;
        const date = document.getElementById('txDateInput').value || getOffsetDate(0);
        const wallet = document.getElementById('txWalletInput').value;
        const note = document.getElementById('txNoteInput').value.trim();

        if (!amount || !note) return;

        appState.transactions.unshift({
          id: 'tx_' + Date.now(),
          type,
          amount,
          category,
          wallet,
          date,
          note
        });
        saveState();
        document.getElementById('txAmountInput').value = '';
        document.getElementById('txNoteInput').value = '';
        renderAll();
        showToast(
          type === 'income' ? 'Ghi Nhận Thu Nhập Thành Công' : 'Ghi Nhận Chi Tiêu Thành Công',
          {
            badge: type === 'income' ? 'PHIẾU THU HẰNG NGÀY' : 'PHIẾU CHI HẰNG NGÀY',
            subtitle: 'Số liệu đã được cộng dồn vào Sổ Thu Chi & Tổng Quan',
            tone: type,
            rows: [
              { label: 'Số tiền', value: (type === 'income' ? '+' : '-') + formatVND(amount), color: type === 'income' ? 'text-emerald-400 text-sm' : 'text-amber-400 text-sm' },
              { label: 'Danh mục', value: category },
              { label: 'Nguồn tiền', value: wallet },
              { label: 'Nội dung', value: note },
              { label: 'Ngày ghi nhận', value: date }
            ]
          }
        );
      });

      document.getElementById('txSearchInput').addEventListener('input', renderCashflowTab);
      document.getElementById('txFilterType').addEventListener('change', renderCashflowTab);
      document.getElementById('txFilterCategory').addEventListener('change', renderCashflowTab);
      document.getElementById('chartRangeSelect').addEventListener('change', renderCharts);

      // Submit Debt
      document.getElementById('debtForm').addEventListener('submit', e => {
        e.preventDefault();
        const type = document.getElementById('debtTypeInput').value;
        const priority = document.getElementById('debtPriorityInput').value;
        const title = document.getElementById('debtTitleInput').value.trim();
        const totalAmount = Number(document.getElementById('debtTotalInput').value);
        const paidAmount = Number(document.getElementById('debtPaidInput').value || 0);
        const interestRate = Number(document.getElementById('debtRateInput').value || 0);
        const dueDate = document.getElementById('debtDueInput').value;
        const note = document.getElementById('debtNoteInput').value.trim();

        appState.debts.unshift({
          id: 'd_' + Date.now(),
          type,
          priority,
          title,
          totalAmount,
          paidAmount,
          interestRate,
          dueDate,
          note
        });
        saveState();
        closeDebtModal();
        e.target.reset();
        renderAll();
        showToast(
          type === 'borrowed' ? 'Đã Lưu Khoản Nợ Phải Trả' : 'Đã Lưu Khoản Cho Vay',
          {
            badge: type === 'borrowed' ? 'HỒ SƠ NỢ ĐI VAY' : 'HỒ SƠ CHO VAY PHẢI THU',
            subtitle: 'Khoản mục đã được đưa vào danh mục theo dõi dư nợ',
            tone: 'debt',
            rows: [
              { label: 'Khoản mục', value: title },
              { label: 'Tổng gốc', value: formatVND(totalAmount), color: 'text-rose-400 text-sm' },
              { label: 'Còn lại', value: formatVND(Math.max(0, totalAmount - paidAmount)) },
              { label: 'Lãi suất & Ưu tiên', value: interestRate + '%/năm • ' + priority },
              { label: 'Hạn thanh toán', value: dueDate }
            ]
          }
        );
      });

      // Debt Filter
      document.querySelectorAll('.debt-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          activeDebtFilter = btn.getAttribute('data-debtfilter');
          document.querySelectorAll('.debt-filter-btn').forEach(b => b.classList.remove('tab-active'));
          btn.classList.add('tab-active');
          renderDebtsTab();
          if (window.lucide) window.lucide.createIcons();
        });
      });

      // Delegated Clicks (Pay debt, Delete tx/debt)
      document.body.addEventListener('click', e => {
        const payDebtBtn = e.target.closest('[data-paydebt]');
        if (payDebtBtn) {
          const debtId = payDebtBtn.getAttribute('data-paydebt');
          const d = appState.debts.find(item => item.id === debtId);
          if (!d) return;
          const rem = Math.max(0, d.totalAmount - d.paidAmount);
          document.getElementById('payDebtIdInput').value = d.id;
          document.getElementById('payDebtModalTitle').textContent = d.type === 'borrowed' ? 'Trả Nợ: ' + d.title : 'Thu Hồi Nợ: ' + d.title;
          document.getElementById('payDebtInfoText').textContent = `Dư nợ còn lại: ${formatVND(rem)}`;
          document.getElementById('payDebtAmountInput').value = Math.min(rem, 1000000);
          document.getElementById('payDebtAmountInput').max = rem;
          document.getElementById('payDebtModal').classList.remove('hidden');
          document.getElementById('payDebtModal').classList.add('flex');
        }

        const delTxBtn = e.target.closest('[data-deltx]');
        if (delTxBtn) {
          const id = delTxBtn.getAttribute('data-deltx');
          appState.transactions = appState.transactions.filter(t => t.id !== id);
          saveState();
          renderAll();
          showToast('Đã xóa giao dịch');
        }

        const delDebtBtn = e.target.closest('[data-deldebt]');
        if (delDebtBtn) {
          const id = delDebtBtn.getAttribute('data-deldebt');
          appState.debts = appState.debts.filter(d => d.id !== id);
          saveState();
          renderAll();
          showToast('Đã xóa khoản nợ');
        }
      });

      // Pay Debt Submit
      const closePayDebtModal = () => {
        document.getElementById('payDebtModal').classList.add('hidden');
        document.getElementById('payDebtModal').classList.remove('flex');
      };
      document.getElementById('btnClosePayDebtModal').addEventListener('click', closePayDebtModal);
      document.getElementById('btnCancelPayDebt').addEventListener('click', closePayDebtModal);

      document.getElementById('payDebtForm').addEventListener('submit', e => {
        e.preventDefault();
        const id = document.getElementById('payDebtIdInput').value;
        const amt = Number(document.getElementById('payDebtAmountInput').value);
        const sync = document.getElementById('payDebtSyncCashflow').checked;
        const d = appState.debts.find(item => item.id === id);
        if (!d || amt <= 0) return;

        d.paidAmount = Math.min(d.totalAmount, Number(d.paidAmount) + amt);
        if (sync) {
          appState.transactions.unshift({
            id: 'tx_' + Date.now(),
            type: d.type === 'borrowed' ? 'expense' : 'income',
            amount: amt,
            category: d.type === 'borrowed' ? 'Trả nợ & Lãi vay' : 'Thu hồi nợ cho vay',
            wallet: 'Tài khoản Ngân hàng',
            date: getOffsetDate(0),
            note: (d.type === 'borrowed' ? 'Trả nợ: ' : 'Thu hồi nợ: ') + d.title
          });
        }
        saveState();
        closePayDebtModal();
        renderAll();
        const remAfter = Math.max(0, d.totalAmount - d.paidAmount);
        showToast(
          remAfter === 0 ? 'Chúc Mừng! Đã Tất Toán Xong' : 'Cập Nhật Thanh Toán Thành Công',
          {
            badge: d.type === 'borrowed' ? 'BIÊN LAI TRẢ NỢ' : 'BIÊN LAI THU HỒI NỢ',
            subtitle: sync ? 'Đã đồng bộ tự động vào Sổ Thu Chi hằng ngày' : 'Đã cập nhật tiến độ thanh toán gốc',
            tone: 'income',
            rows: [
              { label: 'Khoản mục', value: d.title },
              { label: 'Số tiền vừa thanh toán', value: formatVND(amt), color: 'text-emerald-400 text-sm' },
              { label: 'Dư nợ còn lại', value: formatVND(remAfter), color: remAfter === 0 ? 'text-emerald-400' : 'text-rose-400' },
              { label: 'Tiến độ hoàn thành', value: Math.min(100, Math.round((d.paidAmount / d.totalAmount) * 100)) + '%' }
            ]
          }
        );
      });

      // Theme Studio Modal
      const openThemeModal = () => {
        document.getElementById('themeModal').classList.remove('hidden');
        document.getElementById('themeModal').classList.add('flex');
      };
      const closeThemeModal = () => {
        document.getElementById('themeModal').classList.add('hidden');
        document.getElementById('themeModal').classList.remove('flex');
      };
      document.getElementById('btnDockTheme').addEventListener('click', openThemeModal);
      document.getElementById('btnCloseThemeModal').addEventListener('click', closeThemeModal);
      document.getElementById('btnDoneThemeModal').addEventListener('click', closeThemeModal);

      document.querySelectorAll('.theme-preset-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          appState.theme = btn.getAttribute('data-settheme');
          saveState();
          applyTheme();
          showToast('Hoàn tất! Đã chuyển đổi giao diện mới.');
        });
      });

      document.getElementById('btnResetDemoData').addEventListener('click', () => {
        appState = createInitialState();
        saveState();
        closeThemeModal();
        renderAll();
        showToast('Đã Đặt Lại Toàn Bộ Số Liệu Về 0', {
          badge: 'LÀM MỚI DỮ LIỆU',
          subtitle: 'Tất cả giao dịch và khoản nợ đã được đưa về 0 ₫',
          tone: 'default',
          rows: [
            { label: 'Số dư thuần', value: '0 ₫' },
            { label: 'Tổng thu / Tổng chi', value: '0 ₫ / 0 ₫' },
            { label: 'Tổng dư nợ', value: '0 ₫' }
          ]
        });
      });

      // Completion Popup Modal Buttons
      const closeSuccessPopup = () => {
        const box = document.getElementById('toastBox');
        box.classList.add('hidden');
        box.classList.remove('flex');
      };
      document.getElementById('btnClosePopupModal').addEventListener('click', closeSuccessPopup);
      document.getElementById('btnPopupGoDashboard').addEventListener('click', () => {
        closeSuccessPopup();
        activateTab('dashboard');
      });
      document.getElementById('toastBox').addEventListener('click', e => {
        if (e.target.id === 'toastBox') closeSuccessPopup();
      });
    });
  </script>
</body>
</html>
